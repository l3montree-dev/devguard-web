ORY_SDK_URL=http://localhost:4433
ORY_SDK_PUBLIC_URL=http://localhost:3000

DEVGUARD_API_URL=http://localhost:8080

# Public (browser-facing) API URL. Also required to emit the Content-Security-Policy
# header — if unset, the CSP is dropped (see DISABLE_SECURITY_HEADERS below).
DEVGUARD_API_URL_PUBLIC_INTERNET=http://localhost:8080

# Set this to your Sentry DSN to enable error tracking (empty to disable)
ERROR_TRACKING_DSN=

# Security headers (CSP + hardening) are served by the Next.js server for all
# routes by default. Set to "true" to drop every security header, e.g. when a
# reverse proxy already sets them. Any other value (or unset) keeps them enabled.
DISABLE_SECURITY_HEADERS=false